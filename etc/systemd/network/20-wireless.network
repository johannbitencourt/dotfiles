[Match]
Name=wl*

[Network]
DHCP=yes
MulticastDNS=yes

# systemd-networkd has no per-interface-type default metrics, so with both
# links up the default route is arbitrary. These are NetworkManager's values,
# which prefer ethernet over wifi.
[DHCPv4]
RouteMetric=600

[IPv6AcceptRA]
RouteMetric=600
