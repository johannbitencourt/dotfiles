* {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 13px;
}

window#waybar {
    background-color: #1a1b26;
    color: #c0caf5;
}

#workspaces button {
    padding: 0 8px;
    color: #c0caf5;
}

#workspaces button.active {
    color: #7aa2f7;
}

#clock,
#network,
#battery,
#wireplumber {
    padding: 0 10px;
}
