#!/bin/sh
set -eu

read_cpu() {
  awk '/^cpu / { idle=$5+$6; total=0; for (i=2; i<=NF; i++) total+=$i; print idle, total; exit }' /proc/stat
}

set -- $(read_cpu)
idle1=$1 total1=$2
sleep 1
set -- $(read_cpu)
idle2=$1 total2=$2
delta=$((total2 - total1))
[ "$delta" -gt 0 ] || { printf '0\n'; exit 0; }
printf '%s\n' $((100 * (delta - idle2 + idle1) / delta))
