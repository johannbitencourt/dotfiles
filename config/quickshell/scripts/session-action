#!/bin/sh
set -eu

action=${1:-}
case "$action" in
  lock)
    if command -v hyprlock >/dev/null 2>&1; then exec hyprlock
    elif command -v loginctl >/dev/null 2>&1; then exec loginctl lock-session
    fi
    ;;
  suspend)
    if command -v loginctl >/dev/null 2>&1; then exec loginctl suspend
    elif command -v zzz >/dev/null 2>&1; then exec zzz
    fi
    ;;
  reboot|poweroff)
    if command -v loginctl >/dev/null 2>&1; then exec loginctl "$action"
    elif command -v systemctl >/dev/null 2>&1; then exec systemctl "$action"
    elif command -v doas >/dev/null 2>&1; then exec doas "$action"
    else exec sudo "$action"
    fi
    ;;
  *) exit 2 ;;
esac
exit 127
