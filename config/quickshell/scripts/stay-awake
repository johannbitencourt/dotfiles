#!/bin/sh
set -eu

if command -v systemd-inhibit >/dev/null 2>&1; then
  exec systemd-inhibit --what=idle --who=quickshell --why='Stay Awake enabled' --mode=block sleep infinity
elif command -v wayland-idle-inhibitor >/dev/null 2>&1; then
  exec wayland-idle-inhibitor
fi

# Void has no systemd-inhibit. Pausing hypridle is a dependency-free fallback;
# always resume it when Quickshell stops this helper.
if pgrep -x hypridle >/dev/null 2>&1; then
  trap 'pkill -CONT -x hypridle 2>/dev/null || true' EXIT HUP INT TERM
  pkill -STOP -x hypridle
  while :; do sleep 3600; done
fi

printf 'No idle inhibitor or running hypridle process is available\n' >&2
exit 127
