#!/usr/bin/env bash
set -euo pipefail

if ! command -v pacman >/dev/null 2>&1; then
  echo "This bootstrap requires CachyOS or another pacman-based Arch system." >&2
  exit 1
fi

source_dir={{ .chezmoi.sourceDir | quote }}
packages=()

# Manifest contents are embedded so chezmoi reruns this onchange script when
# any package profile changes.
{{ include "packages/core.txt" | ensureLinePrefix "# core: " -}}
{{ include "packages/cli.txt" | ensureLinePrefix "# cli: " -}}
{{ include "packages/laptop.txt" | ensureLinePrefix "# laptop: " -}}
{{ include "packages/bluetooth.txt" | ensureLinePrefix "# bluetooth: " -}}
{{ include "packages/development.txt" | ensureLinePrefix "# development: " -}}
{{ include "packages/docker.txt" | ensureLinePrefix "# docker: " -}}
{{ include "packages/virtualization.txt" | ensureLinePrefix "# virtualization: " -}}
{{ include "packages/gaming.txt" | ensureLinePrefix "# gaming: " -}}
{{ include "packages/desktop.txt" | ensureLinePrefix "# desktop: " -}}
{{ include "packages/aur-base.txt" | ensureLinePrefix "# aur-base: " -}}

append_manifest() {
  local manifest=$1 package
  while IFS= read -r package || [[ -n "$package" ]]; do
    [[ -z "$package" || "$package" == \#* ]] && continue
    packages+=("$package")
  done < "$source_dir/packages/$manifest.txt"
}

append_manifest core
append_manifest cli

{{- if .isLaptop }}
append_manifest laptop
{{- end }}

{{- if .installBluetooth }}
append_manifest bluetooth
{{- end }}

{{- if .installDevelopment }}
append_manifest development
{{- end }}

{{- if .installDocker }}
append_manifest docker
{{- end }}

{{- if .installVirtualization }}
append_manifest virtualization
{{- end }}

{{- if .installGaming }}
append_manifest gaming
{{- end }}

{{- if .installDesktopApps }}
append_manifest desktop
{{- end }}

{{- if or .installDesktopApps .installGreeter }}
append_manifest aur-base
{{- end }}

sudo pacman -Syu --needed "${packages[@]}"

{{- if or .installDesktopApps .installGreeter }}
if ! command -v paru >/dev/null 2>&1 && ! command -v yay >/dev/null 2>&1; then
  if pacman -Si paru >/dev/null 2>&1; then
    sudo pacman -S --needed paru
  else
    echo "Selected features require an AUR helper. Install paru or yay, then re-run chezmoi apply." >&2
    exit 1
  fi
fi
{{- end }}

aur_install() {
  if command -v paru >/dev/null 2>&1; then
    paru -S --needed "$@"
  elif command -v yay >/dev/null 2>&1; then
    yay -S --needed "$@"
  else
    echo "AUR helper missing for required packages: $*" >&2
    return 1
  fi
}

{{- if .installGreeter }}
aur_install greetd-dms-greeter-bin
{{- end }}

{{- if .installDesktopApps }}
aur_install brave-bin zen-browser-bin spotify
{{- end }}
