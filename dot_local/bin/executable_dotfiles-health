#!/usr/bin/env bash
set -u

failed=0

check_command() {
  if command -v "$1" >/dev/null 2>&1; then
    printf 'ok       %s\n' "$1"
  else
    printf 'missing  %s\n' "$1"
    failed=1
  fi
}

for command in chezmoi Hyprland uwsm foot fuzzel mako hypridle hyprlock waybar \
  tuigreet wpctl notify-send grim slurp wl-copy nvim git \
  osd polkit-agent screenshot-full screenshot-region; do
  check_command "$command"
done

if Hyprland --verify-config --config "$HOME/.config/hypr/hyprland.conf" >/dev/null 2>&1; then
  printf 'ok       hyprland.conf parses\n'
else
  printf 'error    hyprland.conf parses\n'
  failed=1
fi

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  if errors=$(hyprctl configerrors 2>/dev/null) && [[ -z "$errors" ]]; then
    printf 'ok       running session reports no config errors\n'
  else
    printf 'error    running session config errors: %s\n' "$errors"
    failed=1
  fi
fi

exit "$failed"
