#!/usr/bin/env bash
set -euo pipefail

if ! command -v pacman >/dev/null 2>&1; then
  echo "Skipping packages: this bootstrap currently supports Arch derivatives only."
  exit 0
fi

source_dir={{ .chezmoi.sourceDir | quote }}
packages=()

append_manifest() {
  local manifest=$1 package
  while IFS= read -r package || [[ -n "$package" ]]; do
    [[ -z "$package" || "$package" == \#* ]] && continue
    packages+=("$package")
  done < "$source_dir/packages/$manifest.txt"
}

append_manifest core
append_manifest cli

{{- if .isLaptop }}
append_manifest laptop
{{- end }}

{{- if .installBluetooth }}
append_manifest bluetooth
{{- end }}

{{- if .installDevelopment }}
append_manifest development
{{- end }}

{{- if .installVirtualization }}
append_manifest virtualization
{{- end }}

{{- if .installGaming }}
append_manifest gaming
{{- if .isNvidia }}
packages+=(lib32-nvidia-utils)
{{- end }}
{{- end }}

{{- if .installDesktopApps }}
append_manifest desktop
{{- end }}

{{- if or .installDesktopApps .installDevelopment .installGreeter }}
append_manifest aur-base
{{- end }}

available=()
for package in "${packages[@]}"; do
  if pacman -Si "$package" >/dev/null 2>&1; then
    available+=("$package")
  else
    echo "Skipping unavailable package: $package"
  fi
done

sudo pacman -Syu --needed "${available[@]}"

aur_install() {
  if command -v paru >/dev/null 2>&1; then
    paru -S --needed "$@"
  elif command -v yay >/dev/null 2>&1; then
    yay -S --needed "$@"
  else
    echo "Skipping AUR packages (install paru or yay): $*"
  fi
}

{{- if .installDesktopApps }}
aur_install brave-bin zen-browser-bin spotify obsidian
{{- end }}

{{- if .installDevelopment }}
aur_install opencode
{{- end }}
