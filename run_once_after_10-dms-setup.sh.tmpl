#!/usr/bin/env bash
set -euo pipefail

if ! command -v dms >/dev/null 2>&1; then
  echo "DMS is not installed; skipping generated compositor configuration."
  exit 0
fi

for component in colors layout outputs cursor windowrules; do
  dms setup "$component"
done

{{- if .installGreeter }}
if command -v paru >/dev/null 2>&1 || command -v yay >/dev/null 2>&1; then
  dms greeter install
else
  echo "DMS greeter installation requires paru or yay on Arch." >&2
  exit 1
fi
{{- end }}
