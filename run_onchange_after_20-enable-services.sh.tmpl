#!/usr/bin/env bash
set -euo pipefail

systemctl --user daemon-reload
systemctl --user add-wants hyprland-session.target dms.service

sudo systemctl enable NetworkManager.service

{{- if .installBluetooth }}
if systemctl cat bluetooth.service >/dev/null 2>&1; then
  sudo systemctl enable bluetooth.service
else
  echo "Bluetooth profile selected but bluetooth.service is missing." >&2
  exit 1
fi
{{- end }}

{{- if .isLaptop }}
power_conflict=""
for unit in tuned.service tlp.service auto-cpufreq.service system76-power.service; do
  if systemctl is-enabled --quiet "$unit" 2>/dev/null || systemctl is-active --quiet "$unit" 2>/dev/null; then
    power_conflict=$unit
    break
  fi
done
if [[ -n "$power_conflict" ]]; then
  echo "Not enabling power-profiles-daemon: $power_conflict is already configured."
elif systemctl cat power-profiles-daemon.service >/dev/null 2>&1; then
  sudo systemctl enable power-profiles-daemon.service
else
  echo "Laptop profile selected but power-profiles-daemon.service is missing." >&2
  exit 1
fi
{{- end }}

{{- if .installDocker }}
if systemctl cat docker.socket >/dev/null 2>&1; then
  sudo systemctl disable docker.service 2>/dev/null || true
  sudo systemctl enable docker.socket
  sudo usermod -aG docker "$(id -un)"
else
  echo "Docker profile selected but docker.socket is missing." >&2
  exit 1
fi
{{- end }}

{{- if .installVirtualization }}
if systemctl cat libvirtd.socket >/dev/null 2>&1; then
  sudo systemctl disable libvirtd.service 2>/dev/null || true
  sudo systemctl enable libvirtd.socket
  sudo usermod -aG libvirt "$(id -un)"
else
  echo "Virtualization profile selected but libvirtd.socket is missing." >&2
  exit 1
fi
{{- end }}
