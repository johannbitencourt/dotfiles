{{- $name := promptStringOnce . "name" "Full name" "" -}}
{{- $email := promptStringOnce . "email" "Git email" "" -}}
{{- $hostname := promptStringOnce . "hostname" "Hostname" .chezmoi.hostname -}}
{{- $isLaptop := promptBoolOnce . "isLaptop" "Is this a laptop?" false -}}
{{- $isNvidia := promptBoolOnce . "isNvidia" "Does this machine use the proprietary NVIDIA driver?" false -}}
{{- $primaryMonitor := promptStringOnce . "primaryMonitor" "Primary monitor output (blank for automatic)" "" -}}
{{- $disableInternalDisplay := false -}}
{{- if $isLaptop -}}
{{-   $disableInternalDisplay = promptBoolOnce . "disableInternalDisplay" "Disable the internal display?" false -}}
{{- end -}}
{{- $installBluetooth := promptBoolOnce . "installBluetooth" "Install and enable Bluetooth?" $isLaptop -}}
{{- $installDevelopment := promptBoolOnce . "installDevelopment" "Install development tools and Docker?" false -}}
{{- $installVirtualization := promptBoolOnce . "installVirtualization" "Install QEMU/libvirt virtualization?" false -}}
{{- $installGaming := promptBoolOnce . "installGaming" "Install Steam, Lutris, and gaming tools?" false -}}
{{- $installDesktopApps := promptBoolOnce . "installDesktopApps" "Install optional desktop applications?" false -}}
{{- $installGreeter := promptBoolOnce . "installGreeter" "Install and enable the DMS greeter?" true -}}
{{- $browser := "chromium" -}}
{{- if $installDesktopApps -}}
{{-   $browser = "brave" -}}
{{- end -}}

[data]
name = {{ $name | quote }}
email = {{ $email | quote }}
hostname = {{ $hostname | quote }}
isLaptop = {{ $isLaptop }}
isNvidia = {{ $isNvidia }}
primaryMonitor = {{ $primaryMonitor | quote }}
disableInternalDisplay = {{ $disableInternalDisplay }}
installBluetooth = {{ $installBluetooth }}
installDevelopment = {{ $installDevelopment }}
installVirtualization = {{ $installVirtualization }}
installGaming = {{ $installGaming }}
installDesktopApps = {{ $installDesktopApps }}
installGreeter = {{ $installGreeter }}
terminal = "ghostty"
browser = {{ $browser | quote }}
editor = "nvim"
keyboardLayout = "us"
keyboardVariant = "intl"

[diff]
pager = "delta"

[git]
autoCommit = false
autoPush = false
