#!/usr/bin/env bash
set -Eeuo pipefail

# DOTFILES_ROOT bootstrap: install.sh can derive its root from
# ${BASH_SOURCE[0]}'s directory because it always runs from inside the repo
# checkout. dotctl can't assume that — once staged to ~/.local/bin/dotctl as
# a standalone file, the same trick would resolve to ~/.local/bin. Detect
# which context this is: if install/apply.sh exists one level up, we're
# running from a repo checkout (e.g. under test); otherwise fall back to the
# absolute path baked in by stage::generate_scripts at apply time.
_dotctl_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
if [[ -f "${_dotctl_dir}/../install/apply.sh" ]]; then
	DOTFILES_ROOT=$(cd -- "${_dotctl_dir}/.." &>/dev/null && pwd)
else
	DOTFILES_ROOT="@@DOTFILES_ROOT_ABS@@"
fi
readonly DOTFILES_ROOT
unset _dotctl_dir

# shellcheck source=scripts/lib/log.sh
source "${DOTFILES_ROOT}/scripts/lib/log.sh"
# shellcheck source=scripts/lib/cleanup.sh
source "${DOTFILES_ROOT}/scripts/lib/cleanup.sh"
# shellcheck source=scripts/lib/kv-parser.sh
source "${DOTFILES_ROOT}/scripts/lib/kv-parser.sh"
# shellcheck source=scripts/lib/template.sh
source "${DOTFILES_ROOT}/scripts/lib/template.sh"
# shellcheck source=install/adapters/arch.sh
source "${DOTFILES_ROOT}/install/adapters/arch.sh"
# shellcheck source=install/detect.sh
source "${DOTFILES_ROOT}/install/detect.sh"
# shellcheck source=install/preflight.sh
source "${DOTFILES_ROOT}/install/preflight.sh"
# shellcheck source=install/plan.sh
source "${DOTFILES_ROOT}/install/plan.sh"
# shellcheck source=install/profile.sh
source "${DOTFILES_ROOT}/install/profile.sh"
# shellcheck source=install/stage.sh
source "${DOTFILES_ROOT}/install/stage.sh"
# shellcheck source=install/validate.sh
source "${DOTFILES_ROOT}/install/validate.sh"
# shellcheck source=install/commit.sh
source "${DOTFILES_ROOT}/install/commit.sh"
# shellcheck source=install/services.sh
source "${DOTFILES_ROOT}/install/services.sh"
# shellcheck source=install/manifest.sh
source "${DOTFILES_ROOT}/install/manifest.sh"
# shellcheck source=install/rollback.sh
source "${DOTFILES_ROOT}/install/rollback.sh"
# shellcheck source=install/apply.sh
source "${DOTFILES_ROOT}/install/apply.sh"
# shellcheck source=install/diff.sh
source "${DOTFILES_ROOT}/install/diff.sh"
# shellcheck source=install/session.sh
source "${DOTFILES_ROOT}/install/session.sh"
# shellcheck source=install/doctor.sh
source "${DOTFILES_ROOT}/install/doctor.sh"
# shellcheck source=install/uninstall.sh
source "${DOTFILES_ROOT}/install/uninstall.sh"
# shellcheck source=install/diagnose.sh
source "${DOTFILES_ROOT}/install/diagnose.sh"
# shellcheck source=install/recover.sh
source "${DOTFILES_ROOT}/install/recover.sh"
# shellcheck source=install/update.sh
source "${DOTFILES_ROOT}/install/update.sh"
# Note: no install/deploy.sh — dotctl never installs packages.

declare -gA DETECTED=()
declare -gA CLI_PREFERENCES=()

usage() {
	cat <<'EOF'
Usage: dotctl <command> [options]

Commands:
  apply           regenerate and commit config (like install.sh --config-only)
  diff            show what apply would change, without changing anything
  validate        generate and validate config, without committing
  doctor          report on system health (--json for machine-readable output)
  restore-config  restore files from a backup transaction
  uninstall       restore/remove managed files, stop services, write a report
  update config   fetch, fast-forward, and apply upstream changes
  diagnose        write a redacted, portable local diagnostics bundle
  recover         inspect current state and offer the matching fix
  profile         list/show/plan/install/remove a tool profile (e.g. 'dev') — see 'dotctl profile --help'

Run 'dotctl <command> --help' for command-specific options.
EOF
}

cmd::_common_defaults() {
	OPT_HOST=$(hostname -s 2>/dev/null || printf '%s' arch)
	OPT_DRY_RUN=0
	OPT_NON_INTERACTIVE=0
}

# cmd::_acquire_lock — the project lock, taken directly (not via
# apply::acquire_lock_and_txn) by every mutating command that mints no
# config-commit transaction: restore-config, uninstall, update packages,
# profile install/remove. `exec` here affects this same process's fd table,
# not a subshell, so the lock is held for the rest of dotctl's run.
cmd::_acquire_lock() {
	apply::ensure_state_dir
	LOCK_FILE="${STATE_DIR}/lock"
	exec 200>"$LOCK_FILE"
	flock -n 200 || log::die "another install/update is already running (lock: ${LOCK_FILE})"
}

cmd::apply() {
	cmd::_common_defaults
	while [[ $# -gt 0 ]]; do
		case $1 in
		--host)
			OPT_HOST=$2
			shift 2
			;;
		--preference)
			[[ ${2:-} == *=* ]] || log::die "--preference expects KEY=VALUE, got: ${2:-}"
			CLI_PREFERENCES[${2%%=*}]=${2#*=}
			shift 2
			;;
		--dry-run)
			OPT_DRY_RUN=1
			shift
			;;
		--non-interactive)
			OPT_NON_INTERACTIVE=1
			shift
			;;
		--verbose)
			set -x
			shift
			;;
		-h | --help)
			cat <<'EOF'
Usage: dotctl apply [options]

  --host <name>            host profile to use (default: this machine's hostname)
  --preference KEY=VALUE   override a resolved value (repeatable)
  --dry-run                print the plan, mutate nothing
  --non-interactive        never prompt; fail on unresolved conflicts
  --verbose                more log output
EOF
			exit 0
			;;
		*)
			log::die "dotctl apply: unknown option: $1 (see --help)"
			;;
		esac
	done

	[[ $EUID -ne 0 ]] || log::die "refuse to run as root"

	apply::acquire_lock_and_txn
	apply::detect_and_plan_host
	apply::commit_config
	log::info "apply complete"
}

cmd::validate() {
	cmd::_common_defaults
	while [[ $# -gt 0 ]]; do
		case $1 in
		--host)
			OPT_HOST=$2
			shift 2
			;;
		--verbose)
			set -x
			shift
			;;
		-h | --help)
			cat <<'EOF'
Usage: dotctl validate [options]

  --host <name>   host profile to use (default: this machine's hostname)
  --verbose       more log output
EOF
			exit 0
			;;
		*)
			log::die "dotctl validate: unknown option: $1 (see --help)"
			;;
		esac
	done

	apply::detect_and_plan_host
	apply::stage_and_validate
	log::info "validate complete: config generates and validates cleanly"
}

cmd::diff() {
	cmd::_common_defaults
	while [[ $# -gt 0 ]]; do
		case $1 in
		--host)
			OPT_HOST=$2
			shift 2
			;;
		--verbose)
			set -x
			shift
			;;
		-h | --help)
			cat <<'EOF'
Usage: dotctl diff [options]

  --host <name>   host profile to use (default: this machine's hostname)
  --verbose       more log output

Shows what 'dotctl apply' would change. Read-only — never writes anything.
EOF
			exit 0
			;;
		*)
			log::die "dotctl diff: unknown option: $1 (see --help)"
			;;
		esac
	done

	diff::run
}

cmd::doctor() {
	local json_mode=0
	while [[ $# -gt 0 ]]; do
		case $1 in
		--json)
			json_mode=1
			shift
			;;
		--verbose)
			set -x
			shift
			;;
		-h | --help)
			cat <<'EOF'
Usage: dotctl doctor [options]

  --json      machine-readable output (array of {check, status, detail})
  --verbose   more log output

Read-only. Reports PASS/WARN/FAIL/SKIP for each check and keeps going.
EOF
			exit 0
			;;
		*)
			log::die "dotctl doctor: unknown option: $1 (see --help)"
			;;
		esac
	done

	doctor::run "$json_mode"
}

cmd::restore_config() {
	local txn="" use_last=0
	while [[ $# -gt 0 ]]; do
		case $1 in
		--last)
			use_last=1
			shift
			;;
		--transaction)
			txn=$2
			shift 2
			;;
		--verbose)
			set -x
			shift
			;;
		-h | --help)
			cat <<'EOF'
Usage: dotctl restore-config --last | --transaction <id>

  --last              restore the most recent backup transaction
  --transaction <id>  restore a specific transaction by id
  --verbose           more log output
EOF
			exit 0
			;;
		*)
			log::die "dotctl restore-config: unknown option: $1 (see --help)"
			;;
		esac
	done

	if [[ $use_last -eq 1 && -n $txn ]]; then
		log::die "dotctl restore-config: --last and --transaction are mutually exclusive"
	fi
	if [[ $use_last -eq 0 && -z $txn ]]; then
		log::die "dotctl restore-config: specify --last or --transaction <id> (see --help)"
	fi

	apply::ensure_state_dir

	if [[ $use_last -eq 1 ]]; then
		txn=$(rollback::latest_transaction)
		[[ -n $txn ]] || log::die "dotctl restore-config: no backup transactions found under ${STATE_DIR}/backups"
	fi

	# Takes the project lock directly rather than apply::acquire_lock_and_txn:
	# this undoes a past transaction, it doesn't mint a new one.
	cmd::_acquire_lock

	rollback::restore_transaction "$txn"

	# If the restored transaction is the one currently marked active/
	# incomplete, clear the marker — otherwise doctor's incomplete-
	# transaction check would report FAIL forever after a legitimate fix
	# (apply::commit_config already does this on its own rollback path).
	if [[ -f "${STATE_DIR}/active-transaction" && "$(cat "${STATE_DIR}/active-transaction")" == "$txn" ]]; then
		rm -f "${STATE_DIR}/active-transaction"
	fi
}

cmd::uninstall() {
	local remove_packages=0 remove_state=0 keep_config=0 dry_run=0
	OPT_NON_INTERACTIVE=0
	while [[ $# -gt 0 ]]; do
		case $1 in
		--remove-packages)
			remove_packages=1
			shift
			;;
		--remove-state)
			remove_state=1
			shift
			;;
		--keep-config)
			keep_config=1
			shift
			;;
		--dry-run)
			dry_run=1
			shift
			;;
		--non-interactive)
			OPT_NON_INTERACTIVE=1
			shift
			;;
		--verbose)
			set -x
			shift
			;;
		-h | --help)
			cat <<'EOF'
Usage: dotctl uninstall [options]

  --remove-packages   also remove packages this project installed (best-effort; see below)
  --remove-state      also delete ~/.local/state/dotfiles (install.json + all backup history)
  --keep-config       leave generated config files in place; only stop services (and
                       remove packages/state if those flags are also given)
  --dry-run           show what would happen, change nothing
  --non-interactive   never prompt; proceed without asking for confirmation
  --verbose           more log output

Restores every managed file to its pre-project original when a backup of it
exists, otherwise removes it. Native packages and project state are
retained unless their flags are given. Writes a report to
~/.local/share/dotfiles/uninstall-report-<timestamp>.json.
EOF
			exit 0
			;;
		*)
			log::die "dotctl uninstall: unknown option: $1 (see --help)"
			;;
		esac
	done

	[[ $EUID -ne 0 ]] || log::die "refuse to run as root"

	cmd::_acquire_lock

	uninstall::run "$remove_packages" "$remove_state" "$keep_config" "$dry_run"
}

cmd::update() {
	local scope=${1:-}
	case $scope in
	config)
		shift
		cmd::update_config "$@"
		;;
	packages)
		shift
		cmd::update_packages "$@"
		;;
	all)
		shift
		cmd::update_all "$@"
		;;
	"")
		cat <<'EOF'
Usage: dotctl update <scope>

  config     fetch, fast-forward, and apply upstream changes
  packages   ask pacman for the native upgrade plan, then upgrade after approval
  all        runs config, then packages, with a separate confirmation at each step

A bare 'dotctl update' prints these scopes and does not mutate the system.
EOF
		;;
	*)
		log::die "dotctl update: unknown scope: ${scope} (see 'dotctl update' for available scopes)"
		;;
	esac
}

cmd::update_config() {
	cmd::_common_defaults
	while [[ $# -gt 0 ]]; do
		case $1 in
		--host)
			OPT_HOST=$2
			shift 2
			;;
		--preference)
			[[ ${2:-} == *=* ]] || log::die "--preference expects KEY=VALUE, got: ${2:-}"
			CLI_PREFERENCES[${2%%=*}]=${2#*=}
			shift 2
			;;
		--dry-run)
			OPT_DRY_RUN=1
			shift
			;;
		--non-interactive)
			OPT_NON_INTERACTIVE=1
			shift
			;;
		--verbose)
			set -x
			shift
			;;
		-h | --help)
			cat <<'EOF'
Usage: dotctl update config [options]

  --host <name>            host profile to use (default: this machine's hostname)
  --preference KEY=VALUE   override a resolved value (repeatable)
  --dry-run                show incoming commits, stop before merging or applying
  --non-interactive        never prompt; fail on unresolved conflicts during apply
  --verbose                more log output

Fetches origin, fast-forwards this checkout onto it if possible, then runs
the same regenerate/backup/commit/validate/rollback-on-failure sequence as
'dotctl apply'. Refuses on a dirty working tree or a diverged branch; never
forces anything.
EOF
			exit 0
			;;
		*)
			log::die "dotctl update config: unknown option: $1 (see --help)"
			;;
		esac
	done

	[[ $EUID -ne 0 ]] || log::die "refuse to run as root"

	if [[ -n $(git -C "$DOTFILES_ROOT" status --porcelain 2>/dev/null) ]]; then
		log::die "dotctl update config: repo working tree at ${DOTFILES_ROOT} is not clean; commit or stash before updating"
	fi

	if ! git -C "$DOTFILES_ROOT" remote get-url origin >/dev/null 2>&1; then
		log::warn "update config: no 'origin' remote configured for ${DOTFILES_ROOT}"
		return 0
	fi

	log::info "update config: fetching origin..."
	git -C "$DOTFILES_ROOT" fetch origin || log::die "update config: git fetch failed"

	local branch
	branch=$(git -C "$DOTFILES_ROOT" rev-parse --abbrev-ref HEAD)

	if ! git -C "$DOTFILES_ROOT" rev-parse --verify -q "origin/${branch}" >/dev/null 2>&1; then
		log::warn "update config: no origin/${branch} to update against"
		return 0
	fi

	local local_rev remote_rev
	local_rev=$(git -C "$DOTFILES_ROOT" rev-parse HEAD)
	remote_rev=$(git -C "$DOTFILES_ROOT" rev-parse "origin/${branch}")

	if [[ $local_rev == "$remote_rev" ]]; then
		log::info "update config: already up to date (${local_rev:0:7})"
		return 0
	fi

	if ! git -C "$DOTFILES_ROOT" merge-base --is-ancestor HEAD "origin/${branch}"; then
		log::die "update config: local ${branch} has diverged from origin/${branch}; refusing to merge non-fast-forward"
	fi

	log::info "update config: ${local_rev:0:7} -> ${remote_rev:0:7}"
	git -C "$DOTFILES_ROOT" log --oneline "HEAD..origin/${branch}"
	git -C "$DOTFILES_ROOT" diff --stat HEAD "origin/${branch}"

	if [[ $OPT_DRY_RUN -eq 1 ]]; then
		log::info "update config: --dry-run, not merging or applying"
		return 0
	fi

	git -C "$DOTFILES_ROOT" merge --ff-only "origin/${branch}" || log::die "update config: fast-forward merge failed"

	apply::acquire_lock_and_txn
	apply::detect_and_plan_host
	apply::commit_config
	log::info "update config: complete"
}

cmd::update_packages() {
	cmd::_common_defaults
	while [[ $# -gt 0 ]]; do
		case $1 in
		--dry-run)
			OPT_DRY_RUN=1
			shift
			;;
		--non-interactive)
			OPT_NON_INTERACTIVE=1
			shift
			;;
		--verbose)
			set -x
			shift
			;;
		-h | --help)
			cat <<'EOF'
Usage: dotctl update packages [options]

  --dry-run           show the upgrade plan, never upgrade
  --non-interactive   never prompt; refuse to upgrade without one
  --verbose           more log output

Asks pacman for the native upgrade plan (this refreshes local package
metadata even under --dry-run -- pacman has no side-effect-free preview),
then upgrades only after an explicit [y/N] confirmation. Records the plan
and pacman's output under ~/.local/share/dotfiles/update-packages-report-
<timestamp>.json, then runs 'dotctl doctor'. Native packages are NOT
automatically reversible: a config rollback never reverts packages.
EOF
			exit 0
			;;
		*)
			log::die "dotctl update packages: unknown option: $1 (see --help)"
			;;
		esac
	done

	[[ $EUID -ne 0 ]] || log::die "refuse to run as root"

	cmd::_acquire_lock

	update::packages_run
}

cmd::update_all() {
	cmd::_common_defaults
	while [[ $# -gt 0 ]]; do
		case $1 in
		--host)
			OPT_HOST=$2
			shift 2
			;;
		--preference)
			[[ ${2:-} == *=* ]] || log::die "--preference expects KEY=VALUE, got: ${2:-}"
			CLI_PREFERENCES[${2%%=*}]=${2#*=}
			shift 2
			;;
		--dry-run)
			OPT_DRY_RUN=1
			shift
			;;
		--non-interactive)
			OPT_NON_INTERACTIVE=1
			shift
			;;
		--verbose)
			set -x
			shift
			;;
		-h | --help)
			cat <<'EOF'
Usage: dotctl update all [options]

  --host <name>            host profile to use (default: this machine's hostname)
  --preference KEY=VALUE   override a resolved value (repeatable)
  --dry-run                preview both steps, mutate nothing
  --non-interactive        never prompt (config proceeds; packages refuses to upgrade)
  --verbose                more log output

Runs 'dotctl update config' then 'dotctl update packages', each with its own
independent confirmation. A config failure stops before packages ever runs.
Packages are never reverted by a config rollback, in either direction.
EOF
			exit 0
			;;
		*)
			log::die "dotctl update all: unknown option: $1 (see --help)"
			;;
		esac
	done

	[[ $EUID -ne 0 ]] || log::die "refuse to run as root"

	local -a config_args=(--host "$OPT_HOST")
	local pref
	for pref in "${!CLI_PREFERENCES[@]}"; do
		config_args+=(--preference "${pref}=${CLI_PREFERENCES[$pref]}")
	done
	[[ $OPT_DRY_RUN -eq 1 ]] && config_args+=(--dry-run)
	[[ $OPT_NON_INTERACTIVE -eq 1 ]] && config_args+=(--non-interactive)

	log::info "update all: [1/2] config"
	cmd::update_config "${config_args[@]}"

	local -a pkg_args=()
	[[ $OPT_DRY_RUN -eq 1 ]] && pkg_args+=(--dry-run)
	[[ $OPT_NON_INTERACTIVE -eq 1 ]] && pkg_args+=(--non-interactive)

	log::info "update all: [2/2] packages"
	cmd::update_packages "${pkg_args[@]}"

	log::info "update all: complete"
}

cmd::diagnose() {
	while [[ $# -gt 0 ]]; do
		case $1 in
		--verbose)
			set -x
			shift
			;;
		-h | --help)
			cat <<'EOF'
Usage: dotctl diagnose [options]

  --verbose   more log output

Writes a redacted, portable local diagnostics bundle (doctor output, project
state, this host's generated Hyprland config, git state). Never uploaded
anywhere — purely local, for you to inspect or share yourself.
EOF
			exit 0
			;;
		*)
			log::die "dotctl diagnose: unknown option: $1 (see --help)"
			;;
		esac
	done

	diagnose::run
}

cmd::recover() {
	cmd::_common_defaults
	while [[ $# -gt 0 ]]; do
		case $1 in
		--non-interactive)
			OPT_NON_INTERACTIVE=1
			shift
			;;
		--verbose)
			set -x
			shift
			;;
		-h | --help)
			cat <<'EOF'
Usage: dotctl recover [options]

  --non-interactive   never prompt; report findings and defer instead of acting
  --verbose           more log output

Inspects current transaction/config state and offers the one fix that
actually applies right now (never more than one at a time). Exit codes: 0
nothing found or fixed, 2 a finding was reported but not acted on, 1 misuse
or crash.
EOF
			exit 0
			;;
		*)
			log::die "dotctl recover: unknown option: $1 (see --help)"
			;;
		esac
	done

	[[ $EUID -ne 0 ]] || log::die "refuse to run as root"

	local rc=0
	recover::run || rc=$?
	exit "$rc"
}

cmd::profile() {
	local sub=${1:-}
	case $sub in
	list)
		shift
		cmd::profile_list "$@"
		;;
	show)
		shift
		cmd::profile_show "$@"
		;;
	plan)
		shift
		cmd::profile_plan "$@"
		;;
	install)
		shift
		cmd::profile_install "$@"
		;;
	remove)
		shift
		cmd::profile_remove "$@"
		;;
	"" | -h | --help)
		cat <<'EOF'
Usage: dotctl profile <list|show|plan|install|remove> [options]

Tool/workflow profiles (e.g. 'dev') bundle optional command-line capabilities,
their preference defaults, and removal rules — NOT the same thing as this
project's --host <name> host profile (hosts/<name>.conf, this machine's own
hardware/session identity). This command's "profile" always means a
tool/workflow bundle; wherever this project means the other sense, it says
"host profile" or "--host" explicitly, never bare "profile".

Commands:
  list            list every available tool profile
  show <id>       show one tool profile's declared capabilities, preferences,
                  and install status
  plan <id>       preview what 'install <id>' would do — read-only
  install <id>    resolve, confirm, and install a tool profile's packages
  remove <id>     remove a tool profile's packages that nothing else still needs

Run 'dotctl profile <command> --help' for command-specific options.
EOF
		;;
	*)
		log::die "dotctl profile: unknown subcommand: ${sub} (see 'dotctl profile --help')"
		;;
	esac
}

cmd::profile_list() {
	while [[ $# -gt 0 ]]; do
		case $1 in
		-h | --help)
			cat <<'EOF'
Usage: dotctl profile list

List every available tool profile (id, installed y/n, required-capability
count, description). Read-only.
EOF
			exit 0
			;;
		*)
			log::die "dotctl profile list: unknown option: $1 (see --help)"
			;;
		esac
	done
	profile::list
}

cmd::profile_show() {
	local id=""
	while [[ $# -gt 0 ]]; do
		case $1 in
		-h | --help)
			cat <<'EOF'
Usage: dotctl profile show <id>

Show one tool profile's declared capabilities (resolved to real package
names), preference defaults, and install status. Read-only.
EOF
			exit 0
			;;
		-*)
			log::die "dotctl profile show: unknown option: $1 (see --help)"
			;;
		*)
			id=$1
			shift
			;;
		esac
	done
	[[ -n $id ]] || log::die "dotctl profile show: specify a profile id (see --help)"
	profile::show "$id"
}

cmd::profile_plan() {
	cmd::_common_defaults
	local id=""
	while [[ $# -gt 0 ]]; do
		case $1 in
		--host)
			OPT_HOST=$2
			shift 2
			;;
		--verbose)
			set -x
			shift
			;;
		-h | --help)
			cat <<'EOF'
Usage: dotctl profile plan <id> [options]

  --host <name>   host profile to resolve hardware/preferences against
                  (this IS the other, unrelated "host profile" sense — see
                  'dotctl profile --help')
  --verbose       more log output

Preview what 'profile install <id>' would do: which packages are already
present vs. would be installed, and which preference defaults would
actually change. Read-only.
EOF
			exit 0
			;;
		-*)
			log::die "dotctl profile plan: unknown option: $1 (see --help)"
			;;
		*)
			id=$1
			shift
			;;
		esac
	done
	[[ -n $id ]] || log::die "dotctl profile plan: specify a profile id (see --help)"
	profile::plan "$id"
}

cmd::profile_install() {
	cmd::_common_defaults
	local id=""
	while [[ $# -gt 0 ]]; do
		case $1 in
		--host)
			OPT_HOST=$2
			shift 2
			;;
		--dry-run)
			OPT_DRY_RUN=1
			shift
			;;
		--non-interactive)
			OPT_NON_INTERACTIVE=1
			shift
			;;
		--verbose)
			set -x
			shift
			;;
		-h | --help)
			cat <<'EOF'
Usage: dotctl profile install <id> [options]

Installs the named TOOL profile's required capabilities as native packages
(unrelated to --host/host profile selection elsewhere in dotctl).

  --host <name>       host profile to resolve hardware/preferences against
                      (this IS the other, unrelated "host profile" sense —
                      see 'dotctl profile --help')
  --dry-run           print the plan, install nothing
  --non-interactive   never prompt; refuse rather than guess
EOF
			exit 0
			;;
		-*)
			log::die "dotctl profile install: unknown option: $1 (see --help)"
			;;
		*)
			id=$1
			shift
			;;
		esac
	done
	[[ -n $id ]] || log::die "dotctl profile install: specify a profile id (see --help)"
	[[ $EUID -ne 0 ]] || log::die "refuse to run as root"

	cmd::_acquire_lock

	profile::install "$id"
}

cmd::profile_remove() {
	cmd::_common_defaults
	local id=""
	while [[ $# -gt 0 ]]; do
		case $1 in
		--dry-run)
			OPT_DRY_RUN=1
			shift
			;;
		--non-interactive)
			OPT_NON_INTERACTIVE=1
			shift
			;;
		--verbose)
			set -x
			shift
			;;
		-h | --help)
			cat <<'EOF'
Usage: dotctl profile remove <id> [options]

Removes the named TOOL profile's packages that nothing else (no other
installed profile, no core capability) still needs. Preferences it set are
not automatically reverted.

  --dry-run           print what would be removed, remove nothing
  --non-interactive   never prompt; refuse rather than guess
EOF
			exit 0
			;;
		-*)
			log::die "dotctl profile remove: unknown option: $1 (see --help)"
			;;
		*)
			id=$1
			shift
			;;
		esac
	done
	[[ -n $id ]] || log::die "dotctl profile remove: specify a profile id (see --help)"
	[[ $EUID -ne 0 ]] || log::die "refuse to run as root"

	cmd::_acquire_lock

	profile::remove "$id"
}

[[ $# -ge 1 ]] || {
	usage
	exit 1
}
CMD=$1
shift

case $CMD in
apply) cmd::apply "$@" ;;
diff) cmd::diff "$@" ;;
validate) cmd::validate "$@" ;;
doctor) cmd::doctor "$@" ;;
restore-config) cmd::restore_config "$@" ;;
uninstall) cmd::uninstall "$@" ;;
diagnose) cmd::diagnose "$@" ;;
recover) cmd::recover "$@" ;;
profile) cmd::profile "$@" ;;
update) cmd::update "$@" ;;
-h | --help)
	usage
	exit 0
	;;
*)
	log::die "unknown command: ${CMD} (see --help)"
	;;
esac
