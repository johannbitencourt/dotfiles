# Sourced by UWSM into the graphical session, so everything the session starts
# inherits these. This is the single place session environment is defined;
# hyprland.conf deliberately carries no env lines.
#
# XDG_CURRENT_DESKTOP, XDG_SESSION_TYPE, and XDG_SESSION_DESKTOP are set by
# UWSM from the desktop entry and must not be overridden here.

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

export QT_QPA_PLATFORM='wayland;xcb'
export ELECTRON_OZONE_PLATFORM_HINT=auto
export MOZ_ENABLE_WAYLAND=1

export TERMINAL={{ .terminal }}
export EDITOR={{ .editor }}
export VISUAL={{ .editor }}
