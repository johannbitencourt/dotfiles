hl.config({ autogenerated = false })

-- DMS owns these generated modules and updates them from its settings UI.
require("dms.colors")
require("dms.outputs")
require("dms.layout")
require("dms.cursor")
require("dms.binds")
require("dms.windowrules")

hl.env("XDG_CURRENT_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_TYPE", "wayland")
hl.env("QT_QPA_PLATFORM", "wayland")
hl.env("QT_QPA_PLATFORMTHEME", "gtk3")
hl.env("QT_QPA_PLATFORMTHEME_QT6", "gtk3")
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")
hl.env("MOZ_ENABLE_WAYLAND", "1")
hl.env("TERMINAL", {{ .terminal | quote }})
hl.env("EDITOR", {{ .editor | quote }})
hl.env("VISUAL", {{ .editor | quote }})

{{- if .isNvidia }}
hl.env("NVD_BACKEND", "direct")
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
{{- end }}

hl.config({
	input = {
		kb_layout = {{ .keyboardLayout | quote }},
		kb_variant = {{ .keyboardVariant | quote }},
		kb_options = "compose:caps",
		repeat_rate = 30,
		repeat_delay = 150,
		touchpad = {
			scroll_factor = 0.4,
		},
	},
	general = {
		layout = "dwindle",
	},
	dwindle = {
		preserve_split = true,
	},
	misc = {
		disable_hyprland_logo = true,
		disable_splash_rendering = true,
	},
})

{{- if .primaryMonitor }}
hl.monitor({ output = {{ .primaryMonitor | quote }}, mode = "preferred", position = "auto", scale = 1 })
{{- if and .isLaptop .disableInternalDisplay }}
hl.monitor({ output = "eDP-1", disabled = true })
{{- else if .isLaptop }}
hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = 1 })
{{- end }}
{{- end }}

hl.layer_rule({ match = { namespace = "^(quickshell)$" }, no_anim = true })
hl.layer_rule({ match = { namespace = "^dms:.*" }, no_anim = true })

hl.on("hyprland.start", function()
	hl.exec_cmd("dbus-update-activation-environment --systemd --all")
	hl.exec_cmd("systemctl --user start hyprland-session.target")
	hl.exec_cmd("bash -lc 'command -v cliphist >/dev/null && wl-paste --type text --watch cliphist store'")
	hl.exec_cmd("bash -lc 'command -v cliphist >/dev/null && wl-paste --type image --watch cliphist store'")
end)

require("bindings")
