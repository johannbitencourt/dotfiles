hl.config({ autogenerated = false })

-- DMS owns these generated modules and updates them from its settings UI.
require("dms.colors")
require("dms.outputs")
require("dms.layout")
require("dms.cursor")
require("dms.binds")
require("dms.windowrules")

hl.env("XDG_CURRENT_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_TYPE", "wayland")
hl.env("QT_QPA_PLATFORM", "wayland;xcb")
hl.env("QT_QPA_PLATFORMTHEME", "gtk3")
hl.env("QT_QPA_PLATFORMTHEME_QT6", "gtk3")
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")
hl.env("MOZ_ENABLE_WAYLAND", "1")
hl.env("TERMINAL", {{ .terminal | quote }})
hl.env("EDITOR", {{ .editor | quote }})
hl.env("VISUAL", {{ .editor | quote }})

hl.config({
	input = {
		kb_layout = {{ .keyboardLayout | quote }},
		kb_variant = {{ .keyboardVariant | quote }},
		kb_options = "compose:caps",
		repeat_rate = 30,
		repeat_delay = 150,
		touchpad = {
			scroll_factor = 0.4,
		},
	},
	general = {
		layout = "dwindle",
	},
	dwindle = {
		preserve_split = true,
	},
	misc = {
		disable_hyprland_logo = true,
		disable_splash_rendering = true,
	},
{{- if .performanceMode }}
	animations = {
		enabled = false,
	},
	decoration = {
		blur = {
			enabled = false,
		},
		shadow = {
			enabled = false,
		},
	},
{{- end }}
})

hl.layer_rule({ match = { namespace = "^(quickshell)$" }, no_anim = true })
hl.layer_rule({ match = { namespace = "^dms:.*" }, no_anim = true })

hl.on("hyprland.start", function()
	hl.exec_cmd("bash -lc 'dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE HYPRLAND_INSTANCE_SIGNATURE XCURSOR_THEME XCURSOR_SIZE && systemctl --user start hyprland-session.target'")
end)

require("bindings")
