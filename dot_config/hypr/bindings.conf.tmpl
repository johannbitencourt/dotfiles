$mod = SUPER
$terminal = uwsm app -- {{ .terminal }}
$browser = uwsm app -- {{ .browser }} --new-window --ozone-platform=wayland

# Applications
bindd = $mod, RETURN, Terminal, exec, $terminal
bindd = $mod SHIFT, B, Browser, exec, $browser
bindd = $mod SHIFT ALT, B, Private browser, exec, $browser --private
bindd = $mod SHIFT, F, File manager, exec, dms ipc call defaultApp fileManager
bindd = $mod SHIFT, N, Editor, exec, $terminal -e {{ .editor }}
bindd = $mod SHIFT, T, Activity monitor, exec, $terminal -e btop
bindd = $mod SHIFT, D, Docker, exec, $terminal -e lazydocker
bindd = $mod SHIFT, O, Obsidian, exec, uwsm app -- obsidian
bindd = $mod SHIFT, M, Music, exec, uwsm app -- spotify

# DMS shell
bindd = $mod, SPACE, Application launcher, exec, dms ipc call spotlight toggle
bindd = $mod, V, Clipboard history, exec, dms ipc call clipboard toggle
bindd = $mod, M, Process list, exec, dms ipc call processlist focusOrToggle
bindd = $mod, COMMA, Settings, exec, dms ipc call settings focusOrToggle
bindd = $mod, N, Notifications, exec, dms ipc call notifications toggle
bindd = $mod, Y, Wallpapers, exec, dms ipc call dankdash wallpaper
bindd = $mod, TAB, Workspace overview, exec, dms ipc call hypr toggleOverview
bindd = $mod ALT, L, Lock, exec, dms ipc call lock lock
bindd = $mod SHIFT, I, Keybindings, exec, dms ipc call keybinds toggle hyprland
bindd = $mod SHIFT, P, Power menu, exec, dms ipc call powermenu toggle

# Window management
bindd = $mod, Q, Close window, killactive
bindd = $mod, F, Fullscreen, fullscreen
bindd = $mod SHIFT, A, Toggle floating, togglefloating
bindd = $mod, S, Toggle split, layoutmsg, togglesplit
bindd = $mod SHIFT, S, Pseudotile, pseudo

bind = $mod, H, movefocus, l
bind = $mod, L, movefocus, r
bind = $mod, K, movefocus, u
bind = $mod, J, movefocus, d
bind = $mod ALT, H, swapwindow, l
bind = $mod ALT, L, swapwindow, r
bind = $mod ALT, K, swapwindow, u
bind = $mod ALT, J, swapwindow, d

# Workspaces
bind = $mod, 1, workspace, 1
bind = $mod, 2, workspace, 2
bind = $mod, 3, workspace, 3
bind = $mod, 4, workspace, 4
bind = $mod, 5, workspace, 5
bind = $mod, 6, workspace, 6
bind = $mod, 7, workspace, 7
bind = $mod, 8, workspace, 8
bind = $mod, 9, workspace, 9
bind = $mod, 0, workspace, 10
bind = $mod SHIFT, 1, movetoworkspace, 1
bind = $mod SHIFT, 2, movetoworkspace, 2
bind = $mod SHIFT, 3, movetoworkspace, 3
bind = $mod SHIFT, 4, movetoworkspace, 4
bind = $mod SHIFT, 5, movetoworkspace, 5
bind = $mod SHIFT, 6, movetoworkspace, 6
bind = $mod SHIFT, 7, movetoworkspace, 7
bind = $mod SHIFT, 8, movetoworkspace, 8
bind = $mod SHIFT, 9, movetoworkspace, 9
bind = $mod SHIFT, 0, movetoworkspace, 10
bind = $mod, mouse_down, workspace, e+1
bind = $mod, mouse_up, workspace, e-1

# Mouse window controls
bindm = $mod, mouse:272, movewindow
bindm = $mod, mouse:273, resizewindow

# Media and hardware keys are handled through DMS so its OSD stays in sync.
bindel = , XF86AudioRaiseVolume, exec, dms ipc call audio increment 5
bindel = , XF86AudioLowerVolume, exec, dms ipc call audio decrement 5
bindl = , XF86AudioMute, exec, dms ipc call audio mute
bindl = , XF86AudioMicMute, exec, dms ipc call mic mute
bindel = , XF86MonBrightnessUp, exec, dms ipc call brightness increment 5 ""
bindel = , XF86MonBrightnessDown, exec, dms ipc call brightness decrement 5 ""
bindl = , XF86AudioPlay, exec, dms ipc call mpris playPause
bindl = , XF86AudioNext, exec, dms ipc call mpris next
bindl = , XF86AudioPrev, exec, dms ipc call mpris previous
