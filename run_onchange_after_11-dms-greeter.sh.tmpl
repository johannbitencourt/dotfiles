#!/usr/bin/env bash
set -euo pipefail

{{- if .installGreeter }}
if pacman -Q greetd-dms-greeter-bin >/dev/null 2>&1 || pacman -Q greetd-dms-greeter-git >/dev/null 2>&1; then
  dms greeter enable
  dms greeter sync
else
  echo "DMS greeter package is missing. Install greetd-dms-greeter-bin, then re-run chezmoi apply." >&2
  exit 1
fi
{{- else }}
echo "DMS greeter not selected; existing display-manager state is unchanged."
{{- end }}
